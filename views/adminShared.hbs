<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/reset.css" />
    <link rel="stylesheet" href="/styles/ad-recipe-us-style.css" />
    <title>Заявки пользователей</title>
  </head>
  <body>
    <header>
      <a href="/admin"><img class="house" src="/images/house.png" alt="house" /></a>
      <a href="/"><img class="logo" src="/images/logo.png" alt="logo" /></a>
    </header>
    <hr class="line"/>
    <h1>Заявки на добавление рецепта</h1>
    <table class="iksweb">
      <tr>
        <th>Имя пользователя</th>
        <th>Номер заявки</th>
      </tr>
      {{#each recipe_requests}}
        <tr>
          <td>{{this.User.login}}</td>
          <td>{{this.id}}</td>
          <td><a href="/admin/shared/{{this.id}}">Просмотреть заявку</a></td>
        </tr>
      {{/each}}
    </table>
  </body>
</html>